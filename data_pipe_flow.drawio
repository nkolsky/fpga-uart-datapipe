<mxfile host="app.diagrams.net"><diagram name="data pipe flow" id="dpf"><mxGraphModel dx="1600" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1320" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Data pipe flow" style="text;html=1;align=left;verticalAlign=top;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1500" height="36" as="geometry"/></mxCell><mxCell id="t2" value="Left: the UART side at 256 MHz.    Right: the memory side at 100 MHz.    Purple blocks are the clock crossing." style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1500" height="24" as="geometry"/></mxCell><mxCell id="sideL" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#bbbbbb;dashed=1;dashPattern=12 8;strokeWidth=2;verticalAlign=top;fontSize=1;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="640" height="950" as="geometry"/></mxCell><mxCell id="hdrL" value="UART SIDE — 256 MHz" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="640" height="32" as="geometry"/></mxCell><mxCell id="pc" value="PC (host)&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;8 Mbaud · even parity · RTS/CTS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=3;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="180" width="340" height="60" as="geometry"/></mxCell><mxCell id="gRX" value="RECEIVE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;fontSize=15;fontStyle=1;spacingTop=10;opacity=50;" vertex="1" parent="1"><mxGeometry x="100" y="290" width="560" height="320" as="geometry"/></mxCell><mxCell id="phy" value="rx_phy&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;16x oversample, even parity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="130" y="330" width="500" height="44" as="geometry"/></mxCell><mxCell id="mac" value="rx_mac&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;frames of 6 / 11 / 16 B&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="130" y="382" width="500" height="44" as="geometry"/></mxCell><mxCell id="par" value="rx_msg_parser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="130" y="434" width="500" height="40" as="geometry"/></mxCell><mxCell id="cls" value="rx_classifier&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;range checks · critical path&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="130" y="482" width="500" height="46" as="geometry"/></mxCell><mxCell id="bst" value="rx_burst_ctrl — bypass_active" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#999999;strokeWidth=2;dashed=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="130" y="540" width="500" height="40" as="geometry"/></mxCell><mxCell id="gTX" value="TRANSMIT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;fontSize=15;fontStyle=1;spacingTop=10;opacity=50;" vertex="1" parent="1"><mxGeometry x="100" y="650" width="560" height="392" as="geometry"/></mxCell><mxCell id="seq" value="tx_sequencer&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;pops one word from each FIFO&lt;br&gt;unpacks 4 pixels&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="130" y="688" width="285" height="66" as="geometry"/></mxCell><mxCell id="rpl" value="tx_reply_ctrl&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;msg_composer + burst_msg_composer&lt;br&gt;pixel · burst · register replies&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="345" y="772" width="285" height="66" as="geometry"/></mxCell><mxCell id="mux" value="mux&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;reply_drives_mac&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="860" width="180" height="54" as="geometry"/></mxCell><mxCell id="tmc" value="tx_mac" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="130" y="932" width="500" height="40" as="geometry"/></mxCell><mxCell id="tph" value="tx_phy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="130" y="978" width="500" height="40" as="geometry"/></mxCell><mxCell id="cdc" value="cdc_msg_sync&lt;br&gt;256 → 100&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;whole messages in&lt;br&gt;ordered, back-pressured&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=3;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="400" width="200" height="140" as="geometry"/></mxCell><mxCell id="fifo" value="async_fifo x3&lt;br&gt;100 → 256&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;R / G / B pixel words&lt;br&gt;32 bit x 16 each&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=3;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="655" width="200" height="132" as="geometry"/></mxCell><mxCell id="rep" value="cdc_cmd_sync x3&lt;br&gt;100 → 256&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;pixel / burst / register&lt;br&gt;replies&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=3;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="808" width="200" height="124" as="geometry"/></mxCell><mxCell id="sideR" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#bbbbbb;dashed=1;dashPattern=12 8;strokeWidth=2;verticalAlign=top;fontSize=1;" vertex="1" parent="1"><mxGeometry x="970" y="120" width="620" height="950" as="geometry"/></mxCell><mxCell id="hdrR" value="MEMORY SIDE — 100 MHz" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="970" y="130" width="620" height="32" as="geometry"/></mxCell><mxCell id="rout" value="mem_msg_router&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;routes each message by kind&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1000" y="190" width="560" height="52" as="geometry"/></mxCell><mxCell id="gW" value="WRITE PATH" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;fontSize=14;fontStyle=1;spacingTop=10;opacity=50;" vertex="1" parent="1"><mxGeometry x="1000" y="286" width="270" height="230" as="geometry"/></mxCell><mxCell id="wri" value="mem_msg_writer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1020" y="326" width="230" height="38" as="geometry"/></mxCell><mxCell id="pak" value="pixel_word_packer&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;4 px → 1 word + byte enables&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1020" y="376" width="230" height="50" as="geometry"/></mxCell><mxCell id="bwr" value="img_burst_writer&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;gathers 4 words&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1020" y="438" width="230" height="46" as="geometry"/></mxCell><mxCell id="gR" value="READ PATH" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;verticalAlign=top;fontSize=14;fontStyle=1;spacingTop=10;opacity=50;" vertex="1" parent="1"><mxGeometry x="1290" y="286" width="270" height="230" as="geometry"/></mxCell><mxCell id="prd" value="pixel_rd_ctrl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1310" y="326" width="230" height="36" as="geometry"/></mxCell><mxCell id="brd" value="burst_rd_ctrl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1310" y="372" width="230" height="36" as="geometry"/></mxCell><mxCell id="brr" value="img_burst_reader&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;INCR4 R→G→B&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1310" y="418" width="230" height="46" as="geometry"/></mxCell><mxCell id="itl" value="mem_interlock&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;one owner at a time — reads and writes are mutually exclusive&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#999999;strokeWidth=2;dashed=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1000" y="530" width="560" height="44" as="geometry"/></mxCell><mxCell id="gAHB" value="AHB-Lite fabric — INCR4 bursts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;verticalAlign=top;fontSize=14;fontStyle=1;spacingTop=8;opacity=60;" vertex="1" parent="1"><mxGeometry x="1000" y="592" width="560" height="126" as="geometry"/></mxCell><mxCell id="arb" value="round_robin_arbiter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1020" y="630" width="260" height="34" as="geometry"/></mxCell><mxCell id="ahm" value="ahb_master" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1300" y="630" width="240" height="34" as="geometry"/></mxCell><mxCell id="ahd" value="ahb_decoder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1020" y="672" width="260" height="34" as="geometry"/></mxCell><mxCell id="ahs" value="ahb_slave_sram x3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1300" y="672" width="240" height="34" as="geometry"/></mxCell><mxCell id="sram" value="rgb_sram x3 — 32 bit x 16384&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;one per colour · byte lanes independent&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="748" width="560" height="58" as="geometry"/></mxCell><mxCell id="gAPB" value="APB — register path" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;verticalAlign=top;fontSize=14;fontStyle=1;spacingTop=8;opacity=60;" vertex="1" parent="1"><mxGeometry x="1000" y="838" width="560" height="108" as="geometry"/></mxCell><mxCell id="apm" value="apb_master" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1020" y="876" width="170" height="36" as="geometry"/></mxCell><mxCell id="abr" value="apb_bar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1202" y="876" width="170" height="36" as="geometry"/></mxCell><mxCell id="aps" value="apb_slave_rgf → rgf" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1384" y="876" width="156" height="36" as="geometry"/></mxCell><mxCell id="x1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;;exitX=0.5;exitY=1;entryX=0.4;entryY=0;" edge="1" parent="1" source="pc" target="gRX"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="phy" target="mac"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mac" target="par"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="par" target="cls"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;dashed=1;strokeColor=#999999;;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="bst" target="cls"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#9673a6;;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="cls" target="cdc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#9673a6;;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="cdc" target="rout"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#9673a6;;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="sram" target="fifo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#9673a6;;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="fifo" target="seq"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#9673a6;;exitX=0;exitY=0.45;entryX=1;entryY=0.75;" edge="1" parent="1" source="gAPB" target="rep"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#9673a6;;exitX=0;exitY=0.03;entryX=1;entryY=0.55;" edge="1" parent="1" source="rep" target="rpl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="rout" target="gW"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="rout" target="gR"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="wri" target="pak"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pak" target="bwr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="prd" target="brd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="brd" target="brr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;dashed=1;strokeColor=#999999;;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="gW" target="itl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;dashed=1;strokeColor=#999999;;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="gR" target="itl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="itl" target="gAHB"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="gAHB" target="sram"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;;exitX=1;exitY=0.5;entryX=1;entryY=0.3;" edge="1" parent="1" source="rout" target="gAPB"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="seq" target="mux"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;;exitX=0.25;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="rpl" target="mux"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mux" target="tmc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tmc" target="tph"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="tph" target="pc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;HOW DATA MOVES&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;In&lt;/b&gt; &amp;#8212; bytes arrive at rx_phy and are framed into messages. Whole messages cross to the memory side through cdc_msg_sync, and mem_msg_router sends each to the write path, a reader, or the register path, purely by its kind.&lt;br&gt;&lt;br&gt;&lt;b&gt;Out&lt;/b&gt; &amp;#8212; two independent message sources share tx_mac through a mux: tx_sequencer streams image pixels, tx_reply_ctrl answers single reads. Image pixels come back through three FIFOs, replies through a separate, narrower crossing.&lt;br&gt;&lt;br&gt;&lt;b&gt;The two buses never meet&lt;/b&gt; &amp;#8212; register traffic to APB, image traffic to AHB-Lite, chosen by message kind." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1;align=left;verticalAlign=top;fontSize=13;spacing=14;" vertex="1" parent="1"><mxGeometry x="60" y="1060" width="760" height="200" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;WHY THREE FIFOS&lt;/b&gt;&lt;br&gt;&lt;br&gt;A single-manager bus cannot read three SRAMs at once. An INCR4 covers four words of ONE channel &amp;#8212; R0&amp;#8211;R15, then G, then B &amp;#8212; so red runs up to two bursts ahead of blue and each colour needs its own buffer.&lt;br&gt;&lt;br&gt;&lt;b&gt;WHY FULL-IMAGE WRITES ONLY&lt;/b&gt;&lt;br&gt;&lt;br&gt;One burst message carries 4 pixels = ONE word per channel, so four are gathered to build an INCR4. AHB-Lite has no byte strobes, and a narrower rectangle leaves partial words at the end of every row &amp;#8212; those keep the direct port.&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;color:#777&#x27;&gt;Grey dashed blocks are control, not data. Status and event crossings (cdc_level_sync, cdc_pulse_sync) are omitted.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1;align=left;verticalAlign=top;fontSize=13;spacing=14;" vertex="1" parent="1"><mxGeometry x="850" y="1060" width="740" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>