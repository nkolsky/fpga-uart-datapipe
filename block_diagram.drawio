<mxfile host="app.diagrams.net"><diagram name="block diagram" id="bd"><mxGraphModel dx="1600" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1240" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="chip_top — block diagram, by clock domain" style="text;html=1;align=left;verticalAlign=top;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1500" height="32" as="geometry"/></mxCell><mxCell id="t2" value="Every clock crossing lives at chip_top.  The APB master and BAR do too; the AHB fabric sits inside memory_subsystem, where all its clients are." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1500" height="22" as="geometry"/></mxCell><mxCell id="pin" value="inputs&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;CLK100MHZ · CPU_RESETN&lt;br&gt;UART_TXD_IN · UART_RTS&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="180" height="72" as="geometry"/></mxCell><mxCell id="pout" value="outputs&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;UART_RXD_OUT · UART_CTS&lt;br&gt;LED[15:0]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#555555;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="244" width="180" height="72" as="geometry"/></mxCell><mxCell id="clk" value="clocking_subsystem&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;clk_wiz_0&lt;br&gt;100 → 256 MHz&lt;br&gt;reset_synch x2&lt;br&gt;glitchless_clk_mux&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#8a6d1b&#x27;&gt;&lt;b&gt;pll_clk_out&lt;/b&gt; + sync_pll_rst_n&lt;br&gt;&amp;#8594; the 256 MHz column&lt;br&gt;&lt;br&gt;&lt;b&gt;CLK100MHZ&lt;/b&gt; + sync_rst_n&lt;br&gt;&amp;#8594; the 100 MHz column&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="180" height="230" as="geometry"/></mxCell><mxCell id="c256" value="256 MHz — pll_clk_out" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;dashPattern=10 6;strokeWidth=2;verticalAlign=top;fontSize=16;fontStyle=1;spacingTop=10;opacity=45;" vertex="1" parent="1"><mxGeometry x="250" y="120" width="430" height="800" as="geometry"/></mxCell><mxCell id="rx" value="rx_subsystem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;strokeWidth=2;verticalAlign=top;fontSize=14;fontStyle=1;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="270" y="170" width="390" height="250" as="geometry"/></mxCell><mxCell id="rxp" value="rx_phy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#888888;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="286" y="204" width="180" height="30" as="geometry"/></mxCell><mxCell id="rxm" value="rx_mac" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#888888;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="286" y="240" width="180" height="30" as="geometry"/></mxCell><mxCell id="rxs" value="rx_msg_parser" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#888888;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="286" y="276" width="180" height="30" as="geometry"/></mxCell><mxCell id="rxc" value="rx_classifier" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#888888;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="286" y="312" width="180" height="30" as="geometry"/></mxCell><mxCell id="rxb" value="rx_burst_ctrl&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;bypass_active&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#888888;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="286" y="352" width="358" height="46" as="geometry"/></mxCell><mxCell id="tx" value="uart_tx_subsystem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;strokeWidth=2;verticalAlign=top;fontSize=14;fontStyle=1;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="270" y="450" width="390" height="326" as="geometry"/></mxCell><mxCell id="txq" value="tx_sequencer&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;contains its own msg_composer&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#888888;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="286" y="486" width="358" height="42" as="geometry"/></mxCell><mxCell id="txc" value="msg_composer&amp;#160;&amp;#160;·&amp;#160;&amp;#160;burst_msg_composer&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;build reply payloads&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#888888;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="286" y="538" width="358" height="40" as="geometry"/></mxCell><mxCell id="txr" value="tx_reply_ctrl" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#888888;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="286" y="588" width="358" height="30" as="geometry"/></mxCell><mxCell id="txm" value="tx_mac" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#888888;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="286" y="632" width="358" height="30" as="geometry"/></mxCell><mxCell id="txp" value="tx_phy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#888888;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="286" y="668" width="358" height="30" as="geometry"/></mxCell><mxCell id="txn" value="&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;tx_sequencer and tx_reply_ctrl are PARALLEL sources into one mux — neither passes through the other&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#888888;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="286" y="710" width="358" height="44" as="geometry"/></mxCell><mxCell id="ccdc" value="CLOCK DOMAIN CROSSING" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;dashPattern=10 6;strokeWidth=2;verticalAlign=top;fontSize=16;fontStyle=1;spacingTop=10;opacity=45;" vertex="1" parent="1"><mxGeometry x="710" y="120" width="290" height="800" as="geometry"/></mxCell><mxCell id="cm" value="cdc_msg_sync&lt;br&gt;256 → 100&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;one message at a time&lt;br&gt;two-phase req/ack&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="728" y="175" width="254" height="86" as="geometry"/></mxCell><mxCell id="cf" value="async_fifo x3&lt;br&gt;100 → 256&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;R / G / B image words&lt;br&gt;32 bit x 16 each&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="728" y="285" width="254" height="86" as="geometry"/></mxCell><mxCell id="cc" value="cdc_cmd_sync x3&lt;br&gt;100 → 256&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;pixel · burst · register replies&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="728" y="395" width="254" height="78" as="geometry"/></mxCell><mxCell id="cl" value="cdc_level_sync x3&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;fifo flags · burst_active&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="728" y="497" width="254" height="66" as="geometry"/></mxCell><mxCell id="cp" value="cdc_pulse_sync x4&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;accepts · tx_img_done · parity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="728" y="587" width="254" height="66" as="geometry"/></mxCell><mxCell id="cn" value="&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;Every one of these is instantiated at chip_top, not inside a subsystem — the crossing is interconnect, so it lives with the interconnect.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="728" y="675" width="254" height="100" as="geometry"/></mxCell><mxCell id="c100" value="100 MHz — CLK100MHZ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;dashPattern=10 6;strokeWidth=2;verticalAlign=top;fontSize=16;fontStyle=1;spacingTop=10;opacity=45;" vertex="1" parent="1"><mxGeometry x="1030" y="120" width="540" height="800" as="geometry"/></mxCell><mxCell id="mem" value="memory_subsystem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;strokeWidth=2;verticalAlign=top;fontSize=14;fontStyle=1;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1050" y="170" width="500" height="470" as="geometry"/></mxCell><mxCell id="mr" value="mem_msg_router" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#888888;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1066" y="204" width="468" height="30" as="geometry"/></mxCell><mxCell id="mw" value="mem_write_subsystem&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;mem_msg_writer · pixel_word_packer · img_burst_writer&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#888888;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1066" y="240" width="468" height="46" as="geometry"/></mxCell><mxCell id="mi" value="mem_interlock" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#888888;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1066" y="292" width="468" height="28" as="geometry"/></mxCell><mxCell id="mp" value="pixel_rd_ctrl" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#888888;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1066" y="326" width="150" height="28" as="geometry"/></mxCell><mxCell id="mb" value="burst_rd_ctrl" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#888888;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1225" y="326" width="150" height="28" as="geometry"/></mxCell><mxCell id="mg" value="img_burst_reader" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#888888;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1384" y="326" width="150" height="28" as="geometry"/></mxCell><mxCell id="ahb" value="AHB-Lite fabric" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;verticalAlign=top;fontSize=13;fontStyle=1;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="1066" y="364" width="468" height="110" as="geometry"/></mxCell><mxCell id="ah1" value="ahb_master" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf0ef;strokeColor=#b85450;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="392" width="225" height="28" as="geometry"/></mxCell><mxCell id="ah2" value="ahb_decoder" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf0ef;strokeColor=#b85450;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1315" y="392" width="205" height="28" as="geometry"/></mxCell><mxCell id="ah3" value="ahb_slave_sram x3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf0ef;strokeColor=#b85450;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="426" width="225" height="28" as="geometry"/></mxCell><mxCell id="ah4" value="round_robin_arbiter" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf0ef;strokeColor=#b85450;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1315" y="426" width="205" height="28" as="geometry"/></mxCell><mxCell id="ms" value="rgb_sram x3 — 32 bit x 16384&lt;br&gt;&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;byte lanes independent&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1066" y="486" width="468" height="44" as="geometry"/></mxCell><mxCell id="mn" value="&lt;font style=&#x27;font-size:11px;color:#777&#x27;&gt;img_burst_reader replaces rom_sequencer. rgb_sram keeps its direct port for partial-word writes.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#888888;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1066" y="544" width="468" height="72" as="geometry"/></mxCell><mxCell id="apb" value="APB — chip_top level" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;verticalAlign=top;fontSize=13;fontStyle=1;spacingTop=5;" vertex="1" parent="1"><mxGeometry x="1050" y="668" width="500" height="86" as="geometry"/></mxCell><mxCell id="ap1" value="apb_master" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf0ef;strokeColor=#b85450;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1064" y="700" width="230" height="28" as="geometry"/></mxCell><mxCell id="ap2" value="apb_bar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf0ef;strokeColor=#b85450;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1304" y="700" width="230" height="28" as="geometry"/></mxCell><mxCell id="reg" value="register_subsystem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#444444;strokeWidth=2;verticalAlign=top;fontSize=14;fontStyle=1;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1050" y="778" width="500" height="86" as="geometry"/></mxCell><mxCell id="rg1" value="apb_slave_rgf" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#888888;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1066" y="812" width="230" height="30" as="geometry"/></mxCell><mxCell id="rg2" value="rgf — 6 x 32-bit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#888888;strokeWidth=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1306" y="812" width="228" height="30" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;;exitX=1;exitY=0.5;entryX=0;entryY=0.15;" edge="1" parent="1" source="pin" target="rx"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;;exitX=0;exitY=0.15;entryX=1;entryY=0.5;" edge="1" parent="1" source="tx" target="pout"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="rx" target="cm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;;exitX=1;exitY=0.5;entryX=0;entryY=0.07;" edge="1" parent="1" source="cm" target="mem"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;;exitX=0;exitY=0.68;entryX=1;entryY=0.5;" edge="1" parent="1" source="mem" target="cf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;;exitX=0;exitY=0.5;entryX=1;entryY=0.11;" edge="1" parent="1" source="cf" target="tx"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;;exitX=0;exitY=0.4;entryX=1;entryY=0.5;" edge="1" parent="1" source="reg" target="cc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;;exitX=0;exitY=0.5;entryX=1;entryY=0.42;" edge="1" parent="1" source="cc" target="tx"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;;exitX=0.15;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="mem" target="apb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="apb" target="reg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="txc" target="txr"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;;exitX=0.15;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="txq" target="txm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="txr" target="txm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;WHAT SITS WHERE, AND WHY&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Crossings at chip_top&lt;/b&gt; &amp;#8212; every cdc_* instance and all three FIFOs are at the top level. A crossing is interconnect between two subsystems, so it belongs with the interconnect rather than inside either side.&lt;br&gt;&lt;br&gt;&lt;b&gt;APB straddles two levels&lt;/b&gt; &amp;#8212; apb_master and apb_bar are at chip_top, next to the CDC primitives, for the same reason. Only apb_slave_rgf sits inside register_subsystem, because it translates to rgf&#x27;s private port.&lt;br&gt;&lt;br&gt;&lt;b&gt;AHB is entirely inside memory_subsystem&lt;/b&gt; &amp;#8212; all of its clients and all three slaves live there, so nothing would be gained by lifting it out." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1;align=left;verticalAlign=top;fontSize=12;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="910" width="740" height="220" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;MODULE COUNT BY SUBSYSTEM&lt;/b&gt;&lt;br&gt;&lt;br&gt;clocking_subsystem&amp;#160;&amp;#160;3 modules&amp;#160;&amp;#160;(clk_wiz_0, reset_synch x2, glitchless_clk_mux)&lt;br&gt;rx_subsystem&amp;#160;&amp;#160;5&amp;#160;&amp;#160;&amp;#160;&amp;#160;uart_tx_subsystem&amp;#160;&amp;#160;6&lt;br&gt;memory_subsystem&amp;#160;&amp;#160;12 modules, 18 instances&lt;br&gt;register_subsystem&amp;#160;&amp;#160;2&amp;#160;&amp;#160;&amp;#160;&amp;#160;chip_top level&amp;#160;&amp;#160;13 instances&lt;br&gt;&lt;br&gt;&lt;b&gt;TWO BUSES, TWO ADDRESS SPACES&lt;/b&gt;&lt;br&gt;APB&amp;#160;&amp;#160;PADDR[15:8] aperture, [7:0] offset&amp;#160;&amp;#8212;&amp;#160;RGF at 0x00xx&lt;br&gt;AHB&amp;#160;&amp;#160;HADDR[17:16] channel, [15:2] word&amp;#160;&amp;#8212;&amp;#160;R 0x0_0000, G 0x1_0000, B 0x2_0000&lt;br&gt;&lt;br&gt;A transfer exists on one bus only, chosen by message kind, so the two spaces never collide." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1;align=left;verticalAlign=top;fontSize=12;spacing=12;" vertex="1" parent="1"><mxGeometry x="810" y="910" width="760" height="220" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>